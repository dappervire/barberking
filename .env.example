# Lokal: isi DB_* di bawah. Hosting: cukup isi DATABASE_URL.
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=barbershop
PORT=3000

# Hosting: connection string transaction pooler Supabase (port 6543)
# DATABASE_URL=postgresql://postgres.PROJECT-REF:PASSWORD@POOLER-HOST:6543/postgres

# Wajib. Isi dengan teks acak yang panjang.
JWT_SECRET=your_long_random_secret

# Wajib di Vercel, buat ngamanin endpoint /cron/cleanup.
# CRON_SECRET=your_long_random_secret

# Dipakai seed-admin.js dan set-admin-password.js aja. Boleh dihapus setelah dijalankan.
# ADMIN_USERNAME=your_admin_username
# ADMIN_PASSWORD="your_admin_password_min_12_chars"

# Opsional
# BOOKING_TIMEZONE=Asia/Jakarta
# TRUST_PROXY_HOPS=1
